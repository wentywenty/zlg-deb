#!/bin/sh
set -e

NAME=usbcanfd
VERSION=2.10

case "$1" in
  configure)
    if ! dkms status -m $NAME -v $VERSION 2>/dev/null | grep -q added; then
      dkms add -m $NAME -v $VERSION
    fi

    KERNEL_REL=$(uname -r)
    BUILD_DIR="/lib/modules/$KERNEL_REL/build"

    if [ -d "$BUILD_DIR" ]; then
      dkms build -m $NAME -v $VERSION
      dkms install -m $NAME -v $VERSION
    elif hrut_socuid >/dev/null 2>&1; then
      echo "RDK X5 detected via hrut_socuid" >&2
      HDR_DIR="/usr/src/linux-headers-$KERNEL_REL"
      if [ ! -d "$HDR_DIR" ]; then
        HDR_DIR=$(ls -d /usr/src/linux-headers-*rt* 2>/dev/null | head -1)
      fi
      if [ -n "$HDR_DIR" ] && [ -d "$HDR_DIR" ]; then
        echo "Linking $HDR_DIR -> $BUILD_DIR" >&2
        ln -sf "$HDR_DIR" "$BUILD_DIR"
        if [ ! -f "$HDR_DIR/scripts/basic/fixdep" ]; then
          echo "Preparing kernel build tools (make ARCH=arm64 scripts)..." >&2
          make -C "$HDR_DIR" ARCH=arm64 scripts
        fi
        dkms build -m $NAME -v $VERSION
        dkms install -m $NAME -v $VERSION
      else
        echo "ERROR: No kernel headers found in /usr/src/" >&2
        echo "Install: apt install linux-headers-current-rockchip-rk3588" >&2
        exit 1
      fi
    else
      echo "ERROR: Kernel headers not found at $BUILD_DIR" >&2
      echo "" >&2
      echo "DKMS needs kernel headers to compile the $NAME module." >&2
      echo "Install the matching kernel headers package, for example:" >&2
      echo "  Ubuntu/Debian:   apt install linux-headers-$KERNEL_REL" >&2
      echo "  RDK X5/Rockchip: apt install linux-headers-current-rockchip-rk3588" >&2
      echo "  Or search:       apt search linux-headers | grep $KERNEL_REL" >&2
      exit 1
    fi
  ;;
esac
